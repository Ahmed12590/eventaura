Options -Indexes
DirectoryIndex index.html index.php

# Bloque l'accès public aux fichiers SQL, Markdown et de configuration
<FilesMatch "\.(sql|md|ini|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
